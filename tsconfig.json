{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSources": true,
        "sourceMap": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "lib": [
            "DOM",
            "ES5",
            "ES6",
            "ES7"
        ],
        "types": [
            "obsidian-typings",
            "svelte",
            "node"
        ]
    },
    "include": [
        "**/globals.d.ts",
        "**/*.js",
        "**/*.svelte",
        "**/*.ts"
    ]
}
